{
  "name": "unicopilot",
  "displayName": "UniCopilot",
  "description": "Your universal AI coding assistant — bring your own API key. Supports Ollama, Claude, Gemini, NVIDIA NIM, and any OpenAI-compatible provider.",
  "version": "1.0.0",
  "publisher": "unicopilot",
  "icon": "assets/sidebar-icon.svg",
  "license": "LICENSE",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["AI", "Programming Languages", "Other"],
  "keywords": ["ai", "copilot", "ollama", "claude", "gemini", "autocomplete", "chat", "code-completion", "intellisense"],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/license-MIT-blue.svg",
      "href": "https://github.com/unicopilot/unicopilot",
      "description": "License"
    }
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "unicopilot.openChat",
        "title": "UniCopilot: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "unicopilot.triggerInlineCompletion",
        "title": "UniCopilot: Trigger Inline Completion"
      },
      {
        "command": "unicopilot.explainCode",
        "title": "UniCopilot: Explain Selected Code"
      },
      {
        "command": "unicopilot.fixCode",
        "title": "UniCopilot: Fix Selected Code"
      },
      {
        "command": "unicopilot.refactorCode",
        "title": "UniCopilot: Refactor Selected Code"
      },
      {
        "command": "unicopilot.addProvider",
        "title": "UniCopilot: Add / Configure Provider"
      },
      {
        "command": "unicopilot.switchModel",
        "title": "UniCopilot: Switch Model"
      },
      {
        "command": "unicopilot.showStatus",
        "title": "UniCopilot: Show Status"
      }
    ],
    "keybindings": [
      {
        "command": "unicopilot.triggerInlineCompletion",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space",
        "when": "editorTextFocus"
      },
      {
        "command": "unicopilot.openChat",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "unicopilot.explainCode",
          "when": "editorHasSelection",
          "group": "unicopilot@1"
        },
        {
          "command": "unicopilot.fixCode",
          "when": "editorHasSelection",
          "group": "unicopilot@2"
        },
        {
          "command": "unicopilot.refactorCode",
          "when": "editorHasSelection",
          "group": "unicopilot@3"
        }
      ],
      "view/title": [
        {
          "command": "unicopilot.switchModel",
          "when": "view == unicopilot.chatView",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "unicopilot",
          "title": "UniCopilot",
          "icon": "assets/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "unicopilot": [
        {
          "type": "webview",
          "id": "unicopilot.chatView",
          "name": "Chat",
          "icon": "assets/sidebar-icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "UniCopilot",
      "properties": {
        "unicopilot.activeProvider": {
          "type": "string",
          "default": "ollama",
          "enum": ["ollama", "anthropic", "gemini", "nvidia-nim", "openai", "openai-compat"],
          "enumDescriptions": [
            "Local Ollama instance (no API key required)",
            "Anthropic Claude",
            "Google Gemini",
            "NVIDIA NIM",
            "OpenAI (GPT-4, GPT-4o, o1)",
            "Any OpenAI-compatible endpoint"
          ],
          "description": "The active AI provider for completions and chat."
        },
        "unicopilot.activeModel": {
          "type": "string",
          "default": "",
          "description": "The active model name for the selected provider."
        },
        "unicopilot.ollamaBaseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL for your local Ollama instance."
        },
        "unicopilot.customProviderBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL for a custom OpenAI-compatible provider."
        },
        "unicopilot.customProviderName": {
          "type": "string",
          "default": "Custom Provider",
          "description": "Display name for your custom provider."
        },
        "unicopilot.inlineCompletionEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable ghost-text inline completions as you type."
        },
        "unicopilot.inlineCompletionDelay": {
          "type": "number",
          "default": 600,
          "description": "Debounce delay in milliseconds before requesting an inline completion."
        },
        "unicopilot.maxTokens": {
          "type": "number",
          "default": 512,
          "description": "Maximum tokens for inline completions."
        },
        "unicopilot.chatMaxTokens": {
          "type": "number",
          "default": 4096,
          "description": "Maximum tokens for chat responses."
        },
        "unicopilot.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature (0 = deterministic, 2 = very creative)."
        },
        "unicopilot.contextLines": {
          "type": "number",
          "default": 50,
          "description": "Number of lines before/after cursor to include as context."
        },
        "unicopilot.enableTelemetry": {
          "type": "boolean",
          "default": false,
          "description": "Send anonymous usage statistics (no code is ever sent)."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unicopilot/unicopilot.git"
  },
  "homepage": "https://github.com/unicopilot/unicopilot",
  "bugs": {
    "url": "https://github.com/unicopilot/unicopilot/issues"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTests.js",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "@types/mocha": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-electron": "^2.3.0",
    "eslint": "^8.0.0",
    "mocha": "^10.0.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
